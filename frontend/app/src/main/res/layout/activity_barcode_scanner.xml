<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scannerRoot"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clipChildren="true"
    android:clipToPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scannerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clipChildren="false"
        android:clipToPadding="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/barcodePreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter"
        tools:background="#5A554C" />

    <ImageButton
        android:id="@+id/btnScannerClose"
        android:layout_width="41dp"
        android:layout_height="41dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_scan_top_button"
        android:contentDescription="스캔 화면 닫기"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_scan_back_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnScannerFlash"
        android:layout_width="41dp"
        android:layout_height="41dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_scan_top_button"
        android:contentDescription="플래시"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="10dp"
        android:scaleType="center"
        android:src="@drawable/ic_scan_flash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.coworker.jjikmuk.feature.scanner.ScanGuideView
        android:id="@+id/scanGuideView"
        android:layout_width="295dp"
        android:layout_height="353dp"
        android:layout_marginTop="159dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/btnScanGallery"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="164dp"
        android:background="@drawable/bg_scan_side_button"
        android:clickable="true"
        android:contentDescription="갤러리"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanGuideView">

        <ImageView
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_gallery" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnScanCapture"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="145dp"
        android:background="@drawable/bg_scan_capture_outer"
        android:clickable="true"
        android:contentDescription="스캔"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scanGuideView">

        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_scan_capture_inner">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_scan_barcode" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutPreviousScans"
        android:layout_width="136dp"
        android:layout_height="115dp"
        android:background="@drawable/bg_scan_history_panel"
        android:clickable="true"
        android:contentDescription="이전 스캔 기록"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:translationY="73dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="7dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_scan_history_chevron" />

        <TextView
            android:id="@+id/tvPreviousScans"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="이전 스캔 기록"
            android:textColor="#727681"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/galleryScanContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivGalleryScanImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <com.coworker.jjikmuk.feature.scanner.GalleryBarcodeOverlayView
            android:id="@+id/galleryBarcodeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutGalleryScanActions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGalleryReselect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_scan_result_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="다시 이미지 선택"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnGallerySelectBarcode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.45"
                android:background="@drawable/bg_scan_result_primary_button"
                android:clickable="true"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:text="이 바코드 선택"
                android:textColor="#3B3128"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/scannerResultScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#4D000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/scannerResultSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="141dp"
        android:background="@drawable/bg_scan_result_sheet"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="29dp"
        android:paddingTop="21dp"
        android:paddingEnd="29dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/scannerResultHandle"
            android:layout_width="37dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_scan_sheet_handle" />

        <FrameLayout
            android:id="@+id/layoutResultImageArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:minHeight="120dp">

            <TextView
                android:id="@+id/tvRegistrationMessage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="아직 등록되지 않은 상품이거나 신제품 입니다.\n처음으로 제품을 등록해보세요!"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvScanResultSafety"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Safe"
            android:textColor="#16A635"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanResultProductName"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#E6060606"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="농심 새우깡" />

        <TextView
            android:id="@+id/tvScanResultAnalysis"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#727681"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="안전하게 섭취할 수 있습니다." />

        <LinearLayout
            android:id="@+id/layoutScanNutrition"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_scan_result_info_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_scan_nutrient_icon_green"
                    android:gravity="center"
                    android:text="K"
                    android:textColor="#59C66F"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="칼로리"
                    android:textColor="#727681"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="220kcal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_scan_nutrient_icon_yellow"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="#E0B72E"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="단백질"
                    android:textColor="#727681"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanSugar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="25g" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_scan_nutrient_icon_green"
                    android:gravity="center"
                    android:text="F"
                    android:textColor="#59C66F"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="지방"
                    android:textColor="#727681"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanFat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="-"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_scan_nutrient_icon_red"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="#E07064"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:text="탄수화물"
                    android:textColor="#727681"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanSodium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#E07064"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="180mg" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnScanResultPrimary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_scan_result_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="MORE →"
            android:textColor="#3B3128"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnScanRetake"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_scan_result_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="다시 촬영하기"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

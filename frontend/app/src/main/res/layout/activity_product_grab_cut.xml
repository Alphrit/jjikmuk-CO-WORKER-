<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <ImageButton
        android:id="@+id/btnGrabCutBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/bg_scan_top_button"
        android:contentDescription="뒤로가기"
        android:padding="10dp"
        android:src="@drawable/ic_scan_back_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGrabCutTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="18dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="상품 외곽을 그려 주세요"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnGrabCutBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnGrabCutBack"
        app:layout_constraintTop_toTopOf="@id/btnGrabCutBack" />

    <com.coworker.jjikmuk.feature.scanner.GrabCutEditorView
        android:id="@+id/grabCutEditorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:background="#222222"
        app:layout_constraintBottom_toTopOf="@id/tvGrabCutStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGrabCutBack"
        tools:background="#5A554C" />

    <TextView
        android:id="@+id/tvGrabCutStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="손가락으로 상품 외곽을 한 바퀴 그린 뒤 배경 제거를 실행하세요."
        android:textColor="#D7D7D7"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/btnRunGrabCut"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnRunGrabCut"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_scan_result_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="배경 제거 실행"
        android:textColor="#3B3128"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/layoutGrabCutBottomButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/layoutGrabCutBottomButtons"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnResetGrabCut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_scan_result_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="다시 그리기"
            android:textColor="#111111"
            android:textSize="14sp" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnConfirmGrabCut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.45"
            android:background="@drawable/bg_scan_result_primary_button"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="이대로 확정"
            android:textColor="#3B3128"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

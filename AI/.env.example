# Runtime
FOOD_CHATBOT_ENV=development
FOOD_CHATBOT_DB_PROVIDER=sqlite
FOOD_CHATBOT_DB_PATH=./food_chatbot.sqlite3
FOOD_CHATBOT_FALLBACK_TO_MEMORY_ON_DB_ERROR=false

# Protected API and saved conversations
# Replace examples with distinct visible-ASCII secrets of at least 32 bytes.
FOOD_CHATBOT_API_TOKEN=replace-with-chat-service-token-32-bytes
FOOD_CHATBOT_ENABLE_CONVERSATIONS=true
FOOD_CHATBOT_USER_IDENTITY_SECRET=replace-with-user-identity-secret-32-bytes
FOOD_CHATBOT_IDENTITY_MAX_AGE_SECONDS=300
FOOD_CHATBOT_MAX_CONVERSATIONS_PER_USER=200
FOOD_CHATBOT_CONVERSATION_TABLE=chatbot_conversations
FOOD_CHATBOT_CONVERSATION_MESSAGE_TABLE=chatbot_messages

# Request protection
FOOD_CHATBOT_MAX_REQUEST_BYTES=1048576
FOOD_CHATBOT_ENABLE_RATE_LIMIT=true
FOOD_CHATBOT_RATE_LIMIT_REQUESTS=60
FOOD_CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
FOOD_CHATBOT_TRUST_PROXY_HEADERS=false
FOOD_CHATBOT_BEHIND_TRUSTED_GATEWAY=false
# Multi-worker production must provide shared replay protection externally.
FOOD_CHATBOT_SHARED_REPLAY_PROTECTION=false

# Audit privacy: conversation messages are stored in chatbot_messages, while
# raw message duplication in chatbot_logs stays off.
FOOD_CHATBOT_STORE_RAW_MESSAGES=false
FOOD_CHATBOT_CHAT_LOG_TABLE=chatbot_logs

# Product data
FOOD_CHATBOT_PRODUCT_TABLE=products
FOOD_CHATBOT_PRODUCT_LABEL_MAX_AGE_DAYS=180
# Production requires one or more exact source_type:source_id entries.
FOOD_CHATBOT_PRODUCT_LABEL_ELIGIBLE_SOURCES=regulatory_database:foodsafetykorea
FOOD_CHATBOT_PUBLIC_IMAGE_HOSTS=

# Optional OpenAI wording, intent fallback, recipe composition, and RAG.
FOOD_CHATBOT_ENABLE_EXTERNAL_AI=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank to use the built-in https://api.openai.com/v1 endpoint.
# Any override also requires its exact host below.
OPENAI_BASE_URL=
FOOD_CHATBOT_ALLOWED_EXTERNAL_AI_HOSTS=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_RESPONSE_BYTES=2097152

# Signed per-request external-AI consent, separate from the API and identity keys.
FOOD_CHATBOT_EXTERNAL_AI_CONSENT_SECRET=replace-with-external-consent-secret-32-bytes
FOOD_CHATBOT_EXTERNAL_AI_CONSENT_MAX_AGE_SECONDS=60

# RAG
RAG_DOCS_DIR=app/knowledge
CHROMA_DB_DIR=app/chroma_db
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
# General answers require reviewed official excerpt bodies, not internal Markdown.
# Keep true in the service; false is a legacy ungrounded-LLM opt-out.
REQUIRE_RAG_CONTEXT_FOR_LLM=true

# MySQL production configuration
FOOD_CHATBOT_MYSQL_HOST=localhost
FOOD_CHATBOT_MYSQL_PORT=3306
FOOD_CHATBOT_MYSQL_DATABASE=jjikmuk
FOOD_CHATBOT_MYSQL_USER=jjikmuk_ai
FOOD_CHATBOT_MYSQL_PASSWORD=
FOOD_CHATBOT_MYSQL_SSL_CA=
FOOD_CHATBOT_MYSQL_SSL_CERT=
FOOD_CHATBOT_MYSQL_SSL_KEY=
FOOD_CHATBOT_MYSQL_CONNECT_TIMEOUT_SECONDS=5
FOOD_CHATBOT_MYSQL_READ_TIMEOUT_SECONDS=10
FOOD_CHATBOT_MYSQL_WRITE_TIMEOUT_SECONDS=10
FOOD_CHATBOT_MYSQL_POOL_SIZE=5
FOOD_CHATBOT_MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=5
FOOD_CHATBOT_MYSQL_POOL_RECYCLE_SECONDS=300
